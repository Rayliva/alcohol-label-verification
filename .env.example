# Copy to .env and fill in real values. NEVER commit .env.
# See .claude/rules/secrets.md

# ---- Required ----

# Anthropic API key — field extraction and vision fallback.
# Use a dedicated workspace so this key can be revoked in isolation.
#
# Required to run the server, INCLUDING with OCR_ENGINE=fake. Extraction has
# no fixture path, so without this the app starts and then fails on every
# check. The test suite is unaffected: it injects a fake at that boundary.
ANTHROPIC_API_KEY=

# Google Cloud Vision service-account JSON, as a single-line string.
# Grant the "Cloud Vision API User" role only — nothing broader.
# Not required when OCR_ENGINE=fake.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---- Access ----

# One shared agent credential. The app refuses to start without both, rather
# than serving the review queue to anyone who finds the URL.
# Not an identity system: no accounts, no password reset, nothing stored.
# Deliver these out of band — never in the README, never on the sign-in page.
AGENT_USERNAME=
AGENT_PASSWORD=

# Signs the session cookie. Optional: unset means a new key each boot, which
# only means everyone signs in again after a restart.
SESSION_SECRET=

# ---- Configuration ----

# OCR backend: cloud | paddle | fake
#   cloud  - Google Cloud Vision (default in production)
#   paddle - local PaddleOCR, no outbound calls (on-prem path; NOT IMPLEMENTED.
#            Selecting it does not stop the app: startup warming catches the
#            error, /health reports degraded, and every check fails.)
#   fake   - one built-in sample label returned for every image; no keys, no
#            network. Boots the stack; does not read your artwork.
OCR_ENGINE=fake

# Extraction model. Pinned to the Phase 0 benchmark winner.
# Candidates: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
EXTRACTION_MODEL=claude-haiku-4-5

# Model used for the degraded-image vision fallback.
# Needs the high-resolution tier (2576px long edge).
VISION_FALLBACK_MODEL=claude-opus-5

# Thinking mode for the extraction call: disabled | adaptive
# Never omit this — the default changed between model generations.
EXTRACTION_THINKING=disabled

# Effort level: low | medium | high
# Must be "high" or lower when EXTRACTION_THINKING=disabled.
EXTRACTION_EFFORT=low

# ---- Server ----

# Comma-separated allowed origins for CORS. Needed only when the UI is served
# from a different origin than the API, which is the case in local development
# (Vite on 5173) and not in production, where both come from one host.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
