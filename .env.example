# Copy to .env and fill in real values. NEVER commit .env.
# See .claude/rules/secrets.md

# ---- Required ----

# Anthropic API key — field extraction and vision fallback.
# Use a dedicated workspace so this key can be revoked in isolation.
ANTHROPIC_API_KEY=

# Google Cloud Vision service-account JSON, as a single-line string.
# Grant the "Cloud Vision API User" role only — nothing broader.
# Not required when OCR_ENGINE=fake.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---- Configuration ----

# OCR backend: cloud | paddle | fake
#   cloud  - Google Cloud Vision (default in production)
#   paddle - local PaddleOCR, no outbound calls (on-prem path)
#   fake   - deterministic fixtures, no keys, no network (default in tests)
OCR_ENGINE=fake

# Extraction model. Pinned to the Phase 0 benchmark winner.
# Candidates: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
EXTRACTION_MODEL=claude-haiku-4-5

# Model used for the degraded-image vision fallback.
# Needs the high-resolution tier (2576px long edge).
VISION_FALLBACK_MODEL=claude-opus-5

# Thinking mode for the extraction call: disabled | adaptive
# Never omit this — the default changed between model generations.
EXTRACTION_THINKING=disabled

# Effort level: low | medium | high
# Must be "high" or lower when EXTRACTION_THINKING=disabled.
EXTRACTION_EFFORT=low

# ---- Server ----

# Comma-separated allowed origins for CORS (the Vercel URL in production).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
