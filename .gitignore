# Secrets — see .claude/rules/secrets.md
.env
.env.*
!.env.example
*-credentials.json
*service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.vite/
web/dist/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/

# Generated corpus images — regenerate with corpus/generate.py.
# Fixtures and expected verdicts ARE committed; the rendered PNGs are not.
corpus/out/

# Benchmark output
bench-results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Frontend build output and dependencies
web/node_modules/
web/dist/

# The built frontend is committed under api/app/static on purpose: Render's
# build context is api/, so the container cannot reach web/. Rebuild with
# `npm run build` in web/ and copy dist over it. See README > Deployment.
!api/app/static/
